{
  "name": "vanilla-typescript",
  "version": "1.0.0",
  "description": "JavaScript and TypeScript example starter project",
  "scripts": {
    "start": "parcel index.html",
    "build": "parcel build index.html --public-url ./ --no-source-maps && node scripts/copy-assets.cjs",
    "deploy": "vercel --prod"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@types/three": "^0.139.0",
    "@types/webgi": "https://storage.googleapis.com/dist.pixotronics.com/webgi/runtime/bundle-types-0.4.6.tgz",
    "buffer": "^6.0.3",
    "parcel": "^2.16.4",
    "sass": "^1.54.0",
    "typescript": "4.4.4",
    "webgi": "https://storage.googleapis.com/dist.pixotronics.com/webgi/runtime/bundle-0.4.6.tgz"
  },
  "resolutions": {
    "@babel/preset-env": "7.13.8"
  },
  "keywords": [
    "typescript",
    "javascript"
  ],
  "alias": {
    "webgi": "webgi/dist/examples/runtime/bundle.m.js"
  },
  "dependencies": {
    "@studio-freight/lenis": "^0.2.24",
    "gsap": "^3.10.4",
    "vercel": "^27.2.0"
  }
}
